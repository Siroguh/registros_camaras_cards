{
  "name": "@registros/home-assistant-cards",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "hooks:setup": "sh scripts/setup-gitleaks.sh && husky",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src vite.config.ts",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node --check registros-camaras-cards.js",
    "secrets": ".local/bin/gitleaks git --redact --no-banner --report-format template --report-template scripts/gitleaks-report.tmpl --report-path -",
    "secrets:staged": "pnpm secrets --staged"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
